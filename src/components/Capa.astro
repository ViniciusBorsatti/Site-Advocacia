---
import { escritorio } from '../data/escritorio';

const linhasNome = escritorio.nome.split(' ');
const primeiraLinha = linhasNome.slice(0, -1).join(' ');
const segundaLinha = linhasNome[linhasNome.length - 1];
---

<section class="env capa">
  <svg
    class="selo"
    id="selo"
    viewBox="0 0 1428 2508"
    role="img"
    aria-label="Figura da Justiça, marca do escritório"
  >
    <use href="#justica"></use>
  </svg>

  <div>
    <p class="etiqueta surge" style="animation-delay:.5s">
      Advocacia em {escritorio.cidadeCurta}
    </p>

    <h1 class="capa-nome">
      <span><b style="animation-delay:.6s">{primeiraLinha}</b></span>
      <span><b style="animation-delay:.72s">{segundaLinha}</b></span>
    </h1>

    <p class="capa-oab surge" style="animation-delay:.9s">
      Advogada · {escritorio.oab}
    </p>

    <p class="capa-texto surge" style="animation-delay:1s">
      {escritorio.descricaoBreve}
    </p>

    <div class="acoes surge" style="animation-delay:1.12s">
      <a class="btn btn-cheio" href="#contato">Agendar atendimento</a>
      <a class="btn btn-vazio" href="#areas">Áreas de atuação</a>
    </div>
  </div>
</section>

<style>
  .capa {
    display: grid;
    grid-template-columns: 0.62fr 1fr;
    gap: clamp(30px, 6vw, 80px);
    align-items: center;
    padding: calc(var(--altura-topo) + clamp(30px, 7vw, 80px)) 0 clamp(60px, 10vw, 120px);
  }

  .selo {
    color: var(--carmim);
    width: 100%;
    max-width: 290px;
    height: auto;
    justify-self: center;
    clip-path: inset(100% 0 0 0);
    animation: tinta 1.5s var(--suave) 0.25s forwards;
    will-change: clip-path, transform;
  }

  @keyframes tinta {
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  .surge {
    opacity: 0;
    transform: translateY(26px);
    animation: surgir 0.95s var(--suave) forwards;
  }

  @keyframes surgir {
    to {
      opacity: 1;
      transform: none;
    }
  }

  .capa-nome {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(2.5rem, 6.6vw, 4.9rem);
    line-height: 1.03;
    letter-spacing: -0.012em;
    margin-top: 20px;
  }

  .capa-nome span {
    display: block;
    overflow: hidden;
  }

  .capa-nome b {
    display: block;
    font-weight: 400;
    transform: translateY(105%);
    animation: subir 1.1s var(--suave) forwards;
  }

  @keyframes subir {
    to {
      transform: none;
    }
  }

  .capa-oab {
    position: relative;
    margin-top: 26px;
    padding-top: 22px;
    font-size: 14px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--cinza);
  }

  .capa-oab::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    height: 1px;
    width: 100%;
    background: var(--linha);
    transform: scaleX(0);
    transform-origin: left;
    animation: esticar 1.1s var(--suave) 0.75s forwards;
  }

  @keyframes esticar {
    to {
      transform: scaleX(1);
    }
  }

  .capa-texto {
    margin-top: 26px;
    max-width: 46ch;
    color: var(--cinza);
    font-size: 18px;
  }

  .acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 38px;
  }

  .btn {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: inline-block;
    padding: 15px 28px;
    font-size: 13px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid var(--carmim);
    transition: color 0.35s var(--suave);
  }

  .btn::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--carmim);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.45s var(--suave);
  }

  .btn:hover::before {
    transform: scaleX(1);
    transform-origin: left;
  }

  .btn-cheio {
    background: var(--carmim);
    color: #fff;
  }

  .btn-cheio::before {
    background: var(--carmim-claro);
  }

  .btn-vazio {
    color: var(--carmim);
  }

  .btn-vazio:hover {
    color: #fff;
  }

  @media (max-width: 880px) {
    .capa {
      grid-template-columns: 1fr;
      gap: 34px;
      padding-top: calc(var(--altura-topo) + 34px);
    }
    .selo {
      max-width: 150px;
      justify-self: start;
    }
  }

  @media (max-width: 520px) {
    .selo {
      max-width: 120px;
    }
    .btn {
      padding: 13px 20px;
      font-size: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .selo {
      clip-path: none;
    }
    .capa-nome b {
      transform: none;
    }
    .capa-oab::before {
      transform: scaleX(1);
    }
    .surge {
      opacity: 1;
      transform: none;
    }
  }
</style>
